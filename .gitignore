# ==========================================
# Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

# ==========================================
# IDEs and Editors
# ==========================================
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~

# ==========================================
# Go (apps/backend-go)
# ==========================================
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (if using vendoring instead of Go modules directly)
vendor/

# ==========================================
# Rust (services/agent-rust)
# ==========================================
# Generated by Cargo
# Will have compiled files and executables
**/target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# Since the agent is an executable server, Cargo.lock SHOULD be committed.
# Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which conflict with Windows binaries
*.pdb

# ==========================================
# Node.js & TypeScript (packages/client-ts & apps/frontend-example)
# ==========================================
# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
lib/
out/
.next/
.nuxt/

# Typescript specific
*.tsbuildinfo

# Testing & Coverage
coverage/
.nyc_output/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Caches
.eslintcache
.stylelintcache
.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Monorepo Tooling Caches (if you add Turborepo or Nx later)
.turbo/
.nx/